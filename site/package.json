    "vinext": "^1.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "cf": "1.0.0-beta.24",
    "postcss": "^8.5.32",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vite-css-modules": "^1.16.1"
